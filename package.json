{
  "name": "webext-notionish",
  "version": "0.1.0",
  "description": "Restyles Google Docs and Sheets to read like Notion, hiding the chrome around the document.",
  "private": true,
  "author": "kud",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "web-ext run --firefox=nightly --firefox-profile=$HOME/.cache/notionish-dev-profile --profile-create-if-missing --keep-profile-changes",
    "dev:clean": "web-ext run --firefox=nightly",
    "probe:selectors": "pbcopy < tools/selector-probe.js && echo 'selector probe copied — page console (Cmd+Opt+K), Cmd+V, Enter'",
    "probe:spacing": "pbcopy < tools/spacing-probe.js && echo 'spacing probe copied — page console (Cmd+Opt+K), Cmd+V, Enter'",
    "probe:model": "pbcopy < tools/model-probe.js && echo 'model probe copied — page console (Cmd+Opt+K), Cmd+V, Enter'",
    "probe:title": "pbcopy < tools/title-query.js && echo 'title query copied — paste, then click into the document title'",
    "build": "rm -rf web-ext-artifacts/* 2>/dev/null || true && web-ext build --source-dir=. --artifacts-dir=web-ext-artifacts --ignore-files=publish.sh --ignore-files=tools --ignore-files='tools/**' --ignore-files=package-lock.json --ignore-files='.github/**'",
    "lint": "web-ext lint --ignore-files=publish.sh --ignore-files=tools --ignore-files='tools/**' --ignore-files=package-lock.json --ignore-files='.github/**'",
    "version": "sed -E -i 's/^(\\s*\"version\":\\s*)\"[^\"]*\"/\\1\"'\"$npm_package_version\"'\"/' manifest.json && git add manifest.json",
    "sign:listed": "WEB_EXT_API_KEY=$MOZILLA_ADDONS_JWT_ISSUER WEB_EXT_API_SECRET=$MOZILLA_ADDONS_JWT_SECRET web-ext sign --channel=listed --upload-source-code --ignore-files=publish.sh --ignore-files=tools --ignore-files='tools/**' --ignore-files=package-lock.json --ignore-files='.github/**'",
    "sign:self": "WEB_EXT_API_KEY=$MOZILLA_ADDONS_JWT_ISSUER WEB_EXT_API_SECRET=$MOZILLA_ADDONS_JWT_SECRET web-ext sign --channel=unlisted --ignore-files=publish.sh --ignore-files=tools --ignore-files='tools/**' --ignore-files=package-lock.json --ignore-files='.github/**'",
    "publish": "bash publish.sh",
    "mz:browse": "open 'https://addons.mozilla.org/developers/addon/notionish@kud.io/'",
    "mz:listing": "open 'https://addons.mozilla.org/firefox/addon/notionish/'",
    "mz:hub": "open 'https://addons.mozilla.org/developers/'"
  },
  "devDependencies": {
    "web-ext": "10.6.0"
  }
}
